# src/api/client.ts lee esta variable con import.meta.env.VITE_API_BASE.
# Si no se define, cae al default hardcodeado en el propio client.ts
# (http://localhost:8000), que ya coincide con el puerto por defecto de
# `python manage.py runserver` de este repo -- no hace falta copiar este
# archivo a .env para desarrollo local estándar, sólo si el backend corre
# en otro host/puerto.
VITE_API_BASE=http://localhost:8000
